# Godot 4+ specific ignores
.godot/
/android/

# Python
__pycache__/

# Regenerable image intermediates. The recipe (tools/comfy/pipeline.json) is reproducible
# from pinned seeds, so only the picks, masters and review sheets are kept.
tools/comfy/masters/candidates/
docs/mockups/bakeoff/*/*
!docs/mockups/bakeoff/*/sheet.png
!docs/mockups/bakeoff/*/seeds.json

# Sound candidates: only the picked masters are kept (seeds in tools/comfy/sfx_manifest.json).
tools/comfy/masters/sfx/*
!tools/comfy/masters/sfx/engine_loop_102.flac
!tools/comfy/masters/sfx/skid_loop_101.flac
!tools/comfy/masters/sfx/wall_bump_102.flac
!tools/comfy/masters/sfx/coin_104.flac
!tools/comfy/masters/sfx/finish_fanfare_101.flac
!tools/comfy/masters/sfx/ui_click_103.flac
!tools/comfy/masters/sfx/horn_104.flac
!tools/comfy/masters/sfx/horn_police_102.flac
!tools/comfy/masters/sfx/horn_icecream_102.flac
!tools/comfy/masters/sfx/horn_monster_101.flac
!tools/comfy/masters/sfx/horn_dragon_101.flac

# Paint-shop masters (81 MB): leaves nothing is built from, reproducible from the pinned seed
# in asset_manifest.json's `paints` section. The built cards and bodies in art/ are committed.
tools/comfy/masters/paint_*
!tools/comfy/masters/sfx/boost_103.flac
